# Leave Supabase keys EMPTY to run in DEMO MODE (sample properties, no accounts). Fill them in to go live.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public site URL (canonical, hreflang, sitemap, auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# SERVER ONLY. Needed to INVITE team members by email (Admin > Team). Supabase > Project Settings > API > service_role.
# NEVER put this in a NEXT_PUBLIC_ variable and never commit it. Without it you can still promote people who already signed up.
SUPABASE_SERVICE_ROLE_KEY=
# Saved-search alert emails (optional). Without RESEND_API_KEY alerts still appear inside the app.
# CRON_SECRET: any long random string; the daily job (vercel.json) must send it as  Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
RESEND_API_KEY=
EMAIL_FROM=JILO Real Estate <alerts@your-domain.com>
# NEVER expose these to the browser (needed later for the AI assistant):
# OPENROUTER_API_KEY=
# AI_DATABASE_URL=postgresql://ai_readonly.<project-ref>:<password>@<pooler-host>:6543/postgres

# SEO / company facts (all optional; anything left empty is simply left out of the structured data)
NEXT_PUBLIC_COMPANY_LEGAL_NAME=
NEXT_PUBLIC_COMPANY_PHONE=
NEXT_PUBLIC_COMPANY_EMAIL=
NEXT_PUBLIC_COMPANY_ADDRESS=
NEXT_PUBLIC_COMPANY_CITY=Dubai
NEXT_PUBLIC_COMPANY_LICENSE=
NEXT_PUBLIC_SOCIAL_URLS=
# Search Console / Bing Webmaster: paste only the verification code from the HTML-tag method
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
